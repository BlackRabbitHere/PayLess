APP_ENV=development
LOG_LEVEL=INFO
SCRAPER_USER_AGENT=PaymentRouteOptimizer/0.1 (+public-offer-collection)
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=25
MAX_REDIRECTS=3
MAX_RESPONSE_BYTES=5000000
MAX_RETRIES=0
MAX_RETRY_WAIT_SECONDS=30
DEFAULT_RATE_LIMIT_SECONDS=3
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=32
ROBOTS_CACHE_SECONDS=3600
SAVE_RAW_HTML=true
RAW_HTML_RETENTION_DAYS=7
SNAPSHOT_MAX_FILES=200
DATA_DIR=data
PLAYWRIGHT_ENABLED=true
PROVIDER_YATRA_ENABLED=true
PROVIDER_GYFTR_ENABLED=true
PROVIDER_EASEMYTRIP_ENABLED=true
BROWSER_SELECTOR_TIMEOUT_MS=8000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_MAX_REQUESTS=40
# Optional audit metadata only; does not enable/disable providers.
# Robots observations are informational and are not proof of legal permission.
TERMS_REVIEWED_PROVIDERS=
# Explicit offline demo only. All results are labeled FIXTURE. Forbidden in production.
FIXTURE_DIR=
