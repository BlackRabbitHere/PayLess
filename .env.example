# Optional Docker Compose overrides; copy to .env.
# Backend container always uses http://scraper:8000.
SCRAPER_CONNECT_TIMEOUT=5s
SCRAPER_READ_TIMEOUT=30s
SCRAPER_ALLOW_FIXTURES=true
SCRAPER_FIXTURE_DIR=/app/fixtures
# Docker uses the same-origin nginx proxy.
DATABASE_PASSWORD=local-development-only
POSTGRES_PORT=15432
FRONTEND_PORT=4173
# Live mode: SCRAPER_FIXTURE_DIR= and SCRAPER_ALLOW_FIXTURES=false
# TERMS_REVIEWED_PROVIDERS=GYFTR,YATRA,EASEMYTRIP
# PLAYWRIGHT_ENABLED=true
